generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  COD
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MovementReason {
  ORDER_PLACED
  ORDER_CANCELED
  ADMIN_ADJUSTMENT
  STOCK_IMPORT
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  passwordHash        String
  fullName            String?
  role                Role                @default(CUSTOMER)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  addresses           Address[]
  cart                Cart?
  wishlistItems       WishlistItem[]
  orders              Order[]
  inventoryActions    InventoryMovement[] @relation("MovementActor")
  sessions            Session[]
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  recipientName   String
  phone           String
  line1           String
  ward            String?
  district        String?
  city            String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  bookAuthors BookAuthor[]
  createdAt  DateTime     @default(now())
}

model Book {
  id              String               @id @default(uuid()) @db.Uuid
  sku             String               @unique
  isbn            String?              @unique
  slug            String               @unique
  title           String
  description     String?              @db.Text
  coverUrl        String?
  priceVnd        Int
  salePriceVnd    Int?
  stock           Int                  @default(0)
  status          BookStatus           @default(DRAFT)
  categoryId      String               @db.Uuid
  category        Category             @relation(fields: [categoryId], references: [id])
  bookAuthors     BookAuthor[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  stockMovements  InventoryMovement[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, status])
}

model BookAuthor {
  bookId   String @db.Uuid
  authorId String @db.Uuid
  book     Book   @relation(fields: [bookId], references: [id])
  author   Author @relation(fields: [authorId], references: [id])

  @@id([bookId, authorId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  cartId    String   @db.Uuid
  bookId    String   @db.Uuid
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([cartId, bookId])
}

model WishlistItem {
  userId    String   @db.Uuid
  bookId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([bookId])
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  orderCode             String               @unique
  userId                String               @db.Uuid
  user                  User                 @relation(fields: [userId], references: [id])
  status                OrderStatus          @default(PENDING)
  paymentMethod         PaymentMethod        @default(COD)
  subtotalVnd           Int
  shippingFeeVnd        Int
  totalVnd              Int
  addressSnapshot       Json
  note                  String?
  idempotencyKey        String
  requestHash           String
  items                 OrderItem[]
  payments              Payment[]
  inventoryMovements    InventoryMovement[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  bookId         String @db.Uuid
  skuSnapshot    String
  titleSnapshot  String
  unitPriceVnd   Int
  quantity       Int
  lineTotalVnd   Int
  order          Order  @relation(fields: [orderId], references: [id])
  book           Book   @relation(fields: [bookId], references: [id])

  @@index([orderId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  providerTxnId   String?       @unique
  amountVnd       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

model InventoryMovement {
  id          String         @id @default(uuid()) @db.Uuid
  bookId      String         @db.Uuid
  orderId     String?        @db.Uuid
  actorId     String?        @db.Uuid
  delta       Int
  reason      MovementReason
  sourceKey   String         @unique
  note        String?
  createdAt   DateTime       @default(now())
  book        Book           @relation(fields: [bookId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  actor       User?          @relation("MovementActor", fields: [actorId], references: [id])

  @@index([bookId, createdAt])
}
