# LOCAL DEV only — copy to .env (never commit .env)
DB_NAME=bookstore
DB_USER=bookstore
DB_PASSWORD=bookstore_dev_only
# Local development only. db:seed creates or updates this account as ADMIN.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=change-this-local-password
# Cloudinary server credentials. Keep these only in backend .env / deployment secrets.
# Uploads remain unavailable until all three values are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
